# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# APP_URL: Hosted URL
APP_URL=""

# Supabase / PostgreSQL Credentials (Production Cloud Database)
SUPABASE_URL=""
SUPABASE_KEY=""

# AWS Deployment Credentials (S3, ECS, CloudWatch)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
